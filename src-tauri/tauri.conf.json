{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cjas Tools",
  "version": "0.5.0",
  "identifier": "com.cjastools.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Cja's Tools",
        "width": 1100,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Every little tool, on your computer.",
    "longDescription": "171 free tools for PDFs, images, video, audio, text, money and more. Works completely offline. Your files never leave your device."
  }
}
